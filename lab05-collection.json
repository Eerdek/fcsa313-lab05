{
  "info": {
    "_postman_id": "86b51c82-0d56-44d0-bfa4-ece9a0d87c10",
    "name": "Lab05 Registration API",
    "description": "F.CSA313 Лаб 5 — POST /registrations функцийн систем тест. Хавтас бүр = нэг спецификаци; setup (PUT) + POST + oracle-уудыг өөртөө агуулна.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "S1 Идэвхтэй, урьдач нөхцөл хангасан оюутан бүртгүүлэхэд 201 OK",
      "description": "Happy path: active оюутан CS201 үзсэн, CS313 нь CS201 урьдач нөхцөлтэй.",
      "item": [
        {
          "name": "Setup: PUT /students/B231234567",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/B231234567",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "B231234567"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"coursesTaken\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Setup: PUT /courses/CS313",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/CS313",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "CS313"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prerequisites\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "POST /registrations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentID\": \"B231234567\",\n  \"courseID\": \"CS313\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус код 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"result = OK\", function () {",
                  "    pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});",
                  "pm.test(\"registrationID тоо байна (яг утгыг шалгахгүй)\", function () {",
                  "    const id = pm.response.json().registrationID;",
                  "    pm.expect(id).to.be.a(\"number\");",
                  "    pm.expect(id).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
